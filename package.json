{
  "name": "ledayazilim-diecutting-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Ledayazılım Diecutting API — parametrik bıçak izi üretimi",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "node --test --experimental-strip-types packages/*/test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "dependencies": {
    "@diecut/core": "*",
    "@diecut/exporters": "*",
    "@diecut/importers": "*",
    "@diecut/templates": "*",
    "@hono/node-server": "^1.19.0",
    "hono": "^4.9.0",
    "jose": "^6.0.0",
    "postgres": "^3.4.7",
    "tsx": "^4.20.0"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "typescript": "^5.9.0"
  }
}
